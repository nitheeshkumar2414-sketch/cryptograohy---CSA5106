#include <stdio.h>
#include <stdint.h>
#include <string.h>

// Function to simulate Feistel cipher round function 
uint32_t feistelFunction(uint32_t right, uint32_t subkey) {
    // Expansion and Substitution simulation for demonstration
    return (right ^ subkey) + 0x5EE56478; 
}

// Simplified DES / Feistel Round Implementation
void desRound(uint32_t *left, uint32_t *right, uint32_t subkey) {
    uint32_t temp = *right;
    *right = *left ^ feistelFunction(*right, subkey);
    *left = temp;
}

// DES Encryption function (16 Rounds structure)
void desEncrypt(uint64_t *block, uint64_t key) {
    uint32_t left = (uint32_t)(*block >> 32);
    uint32_t right = (uint32_t)(*block & 0xFFFFFFFF);

    // 16 Rounds of Feistel Cipher
    for (int i = 0; i < 16; i++) {
        uint32_t subkey = (uint32_t)(key >> (i % 4 * 8)); // Generate subkey per round
        desRound(&left, &right, subkey);
    }

    // Combine left and right back into a 64-bit block (Swap final halves)
    *block = ((uint64_t)right << 32) | left;
}

// DES Decryption function (16 Rounds in reverse)
void desDecrypt(uint64_t *block, uint64_t key) {
    uint32_t left = (uint32_t)(*block >> 32);
    uint32_t right = (uint32_t)(*block & 0xFFFFFFFF);

    // 16 Rounds in reverse order for decryption
    for (int i = 15; i >= 0; i--) {
        uint32_t subkey = (uint32_t)(key >> (i % 4 * 8));
        desRound(&left, &right, subkey);
    }

    *block = ((uint64_t)right << 32) | left;
}

int main() {
    uint64_t plaintext, key;

    printf("--- Data Encryption Standard (DES) Simulation ---\n");
    
    // Default standard test vectors or user input
    printf("Enter 64-bit Plaintext (Hex, e.g., 0x0123456789ABCDEF): ");
    scanf("%llx", &plaintext);

    printf("Enter 64-bit Key (Hex, e.g., 0x133457799BBCDFF1): ");
    scanf("%llx", &key);

    printf("\nOriginal Plaintext : 0x%016llX\n", plaintext);
    printf("Encryption Key     : 0x%016llX\n", key);

    // Encrypt
    uint64_t ciphertext = plaintext;
    desEncrypt(&ciphertext, key);
    printf("Encrypted Ciphertext: 0x%016llX\n", ciphertext);

    // Decrypt
    uint64_t decryptedtext = ciphertext;
    desDecrypt(&decryptedtext, key);
    printf("Decrypted Plaintext : 0x%016llX\n", decryptedtext);

    return 0;
}


// Function to encrypt the plaintext using Vigenere Cipher
void encryptVigenere(char text[], char key[]) {
    int textLen = strlen(text);
    int keyLen = strlen(key);
    char cipherText[1000];
    int j = 0;

    for (int i = 0; i < textLen; i++) {
        char ch = text[i];

        // Encrypt uppercase letters
        if (ch >= 'A' && ch <= 'Z') {
            char k = toupper(key[j % keyLen]);
            cipherText[i] = ((ch - 'A' + (k - 'A')) % 26) + 'A';
            j++; // Move to next letter in key only when alphabet is processed
        }
        // Encrypt lowercase letters
        else if (ch >= 'a' && ch <= 'z') {
            char k = tolower(key[j % keyLen]);
            cipherText[i] = ((ch - 'a' + (k - 'a')) % 26) + 'a';
            j++;
        }
        else {
            // Leave non-alphabetic characters unchanged
            cipherText[i] = ch;
        }
    }
    cipherText[textLen] = '\0';
    printf("\nEncrypted Ciphertext: %s\n", cipherText);
}

// Function to decrypt the ciphertext using Vigenere Cipher
void decryptVigenere(char text[], char key[]) {
    int textLen = strlen(text);
    int keyLen = strlen(key);
    char plainText[1000];
    int j = 0;

    for (int i = 0; i < textLen; i++) {
        char ch = text[i];

        // Decrypt uppercase letters
        if (ch >= 'A' && ch <= 'Z') {
            char k = toupper(key[j % keyLen]);
            plainText[i] = ((ch - 'A' - (k - 'A') + 26) % 26) + 'A';
            j++;
        }
        // Decrypt lowercase letters
        else if (ch >= 'a' && ch <= 'z') {
            char k = tolower(key[j % keyLen]);
            plainText[i] = ((ch - 'a' - (k - 'a') + 26) % 26) + 'a';
            j++;
        }
        else {
            // Leave non-alphabetic characters unchanged
            plainText[i] = ch;
        }
    }
    plainText[textLen] = '\0';
    printf("\nDecrypted Plaintext: %s\n", plainText);
}


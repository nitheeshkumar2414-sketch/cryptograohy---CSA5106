#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdint.h>

#define LEFTROTATE(value, bits) (((value) << (bits)) | ((value) >> (32 - (bits))))

// Structure to represent SHA-1 context
typedef struct {
    uint32_t state[5];
    uint64_t count;
    uint8_t buffer[64];
} SHA1_CTX;

// Initialize SHA-1 state variables
void sha1_init(SHA1_CTX *context) {
    context->state[0] = 0x67452301;
    context->state[1] = 0xEFCDAB89;
    context->state[2] = 0x98BADCFE;
    context->state[3] = 0x10325476;
    context->state[4] = 0xC3D2E1F0;
    context->count = 0;
}

// Process 512-bit blocks
void sha1_transform(uint32_t state[5], const uint8_t buffer[64]) {
    uint32_t a, b, c, d, e, i, j, t, w[80];

    for (i = 0, j = 0; i < 16; i++, j += 4) {
        w[i] = ((uint32_t)buffer[j]) << 24 |
               ((uint32_t)buffer[j + 1]) << 16 |
               ((uint32_t)buffer[j + 2]) << 8 |
               ((uint32_t)buffer[j + 3]);
    }

    for (i = 16; i < 80; i++) {
        w[i] = LEFTROTATE(w[i - 3] ^ w[i - 8] ^ w[i - 14] ^ w[i - 16], 1);
    }

    a = state[0];
    b = state[1];
    c = state[2];
    d = state[3];
    e = state[4];

    for (i = 0; i < 80; i++) {
        uint32_t f, k;

        if (i < 20) {
            f = (b & c) | ((~b) & d);
            k = 0x5A827999;
        } else if (i < 40) {
            f = b ^ c ^ d;
            k = 0x6ED9EBA1;
        } else if (i < 60) {
            f = (b & c) | (b & d) | (c & d);
            k = 0x8F1BBCDC;
        } else {
            f = b ^ c ^ d;
            k = 0xCA62C1D6;
        }

        t = LEFTROTATE(a, 5) + f + e + k + w[i];
        e = d;
        d = c;
        c = LEFTROTATE(b, 30);
        b = a;
        a = t;
    }

    state[0] += a;
    state[1] += b;
    state[2] += c;
    state[3] += d;
    state[4] += e;
}

// Update context with data block
void sha1_update(SHA1_CTX *context, const uint8_t *data, size_t len) {
    size_t i, j;

    j = (size_t)((context->count >> 3) & 63);
    context->count += (uint64_t)len << 3;

    if ((j + len) > 63) {
        i = 64 - j;
        memcpy(&context->buffer[j], data, i);
        sha1_transform(context->state, context->buffer);
        for (; i + 63 < len; i += 64) {
            sha1_transform(context->state, &data[i]);
        }
        j = 0;
    } else {
        i = 0;
    }

    memcpy(&context->buffer[j], &data[i], len - i);
}

// Finalize hashing and store 20-byte digest
void sha1_final(SHA1_CTX *context, uint8_t digest[20]) {
    uint8_t finalcount[8];
    uint32_t i;
    uint8_t c;

    for (i = 0; i < 8; i++) {
        finalcount[i] = (uint8_t)((context->count >> ((7 - (i & 7)) * 8)) & 255);
    }

    c = 0200;
    sha1_update(context, &c, 1);

    while ((context->count & 504) != 448) {
        c = 0x00;
        sha1_update(context, &c, 1);
    }

    sha1_update(context, finalcount, 8);

    for (i = 0; i < 20; i++) {
        digest[i] = (uint8_t)((context->state[i >> 2] >> ((3 - (i & 3)) * 8)) & 255);
    }
}

int main() {
    char input[1024];
    SHA1_CTX ctx;
    uint8_t digest[20];

    printf("--- SHA-1 Hashing Program ---\n");
    printf("Enter message to hash: ");
    fgets(input, sizeof(input), stdin);
    input[strcspn(input, "\n")] = '\0'; // Remove trailing newline

    sha1_init(&ctx);
    sha1_update(&ctx, (uint8_t *)input, strlen(input));
    sha1_final(&ctx, digest);

    printf("SHA-1 Hash Output: ");
    for (int i = 0; i < 20; i++) {
        printf("%02x", digest[i]);
    }
    printf("\n");

    return 0;
}

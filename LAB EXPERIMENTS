// Function to calculate (base^exp) % mod safely
long long int power(long long int base, long long int exp, long long int mod) {
    long long int res = 1;
    base = base % mod;
    while (exp > 0) {
        if (exp % 2 == 1)
            res = (res * base) % mod;
        base = (base * base) % mod;
        exp /= 2;
    }
    return res;
}

// Function to calculate greatest common divisor (GCD)
long long int gcd(long long int a, long long int h) {
    long long int temp;
    while (1) {
        temp = a % h;
        if (temp == 0)
            return h;
        a = h;
        h = temp;
    }
}

// Function to find modular inverse of e modulo phi
long long int modInverse(long long int e, long long int phi) {
    long long int t = 0, newt = 1;
    long long int r = phi, newr = e;
    long long int quotient, temp;

    while (newr != 0) {
        quotient = r / newr;

        temp = t;
        t = newt;
        newt = temp - quotient * newt;

        temp = r;
        r = newr;
        newr = temp - quotient * newr;
    }

    if (r > 1) return -1; // e is not invertible
    if (t < 0) t = t + phi;
    return t;
}

int main() {
    // Step 1: Select two prime numbers (for lab simplicity, small primes are used)
    long long int p, q;
    
    printf("--- RSA Algorithm Program ---\n");
    printf("Enter first prime number (p): ");
    scanf("%lld", &p);

    printf("Enter second prime number (q): ");
    scanf("%lld", &q);

    // Step 2: Compute n = p * q
    long long int n = p * q;

    // Step 3: Compute Euler's totient function phi(n) = (p - 1) * (q - 1)
    long long int phi = (p - 1) * (q - 1);

    // Step 4: Choose public exponent 'e' such that 1 < e < phi and gcd(e, phi) = 1
    long long int e;
    printf("Enter public key exponent (e) [e.g., 3, 17, 65537]: ");
    scanf("%lld", &e);

    if (gcd(e, phi) != 1) {
        printf("Error: 'e' is not coprime to phi(n). Please choose another 'e'.\n");
        return 0;
    }

    // Step 5: Compute private exponent 'd' such that (d * e) % phi = 1
    long long int d = modInverse(e, phi);
    if (d == -1) {
        printf("Error: Modular inverse does not exist.\n");
        return 0;
    }

    printf("\n--- Generated Keys ---\n");
    printf("Public Key  (e, n) = (%lld, %lld)\n", e, n);
    printf("Private Key (d, n) = (%lld, %lld)\n", d, n);

    // Step 6: Input Message (as an integer number less than n)
    long long int msg;
    printf("\nEnter message as an integer (less than %lld): ", n);
    scanf("%lld", &msg);

    // Step 7: Encryption: c = (msg^e) % n
    long long int ciphertext = power(msg, e, n);
    printf("Encrypted Ciphertext: %lld\n", ciphertext);

    // Step 8: Decryption: decrypted_msg = (ciphertext^d) % n
    long long int decryptedtext = power(ciphertext, d, n);
    printf("Decrypted Plaintext : %lld\n", decryptedtext);

    return 0;
}


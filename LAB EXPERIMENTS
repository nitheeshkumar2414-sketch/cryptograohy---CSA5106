int main() {
    long long int p, g, a, b, A, B, keyA, keyB;

    printf("--- Diffie-Hellman Key Exchange Program ---\n");

    // Step 1: Publicly agreed prime number (p) and generator/base (g)
    printf("Enter public prime number (p, e.g., 23): ");
    scanf("%lld", &p);

    // Prevent division/modulo by zero (SIGFPE check)
    if (p <= 1) {
        printf("Error: Prime number 'p' must be greater than 1 to avoid division by zero.\n");
        return 0;
    }

    printf("Enter public generator (g, e.g., 5): ");
    scanf("%lld", &g);

    // Step 2: Alice's private key
    printf("\nEnter Alice's Private Key (a): ");
    scanf("%lld", &a);

    // Step 3: Bob's private key
    printf("Enter Bob's Private Key (b): ");
    scanf("%lld", &b);

    // Step 4: Generate public values to exchange
    A = power(g, a, p);
    B = power(g, b, p);

    printf("\n--- Exchanged Public Keys --- \n");
    printf("Alice sends to Bob (A)   : %lld\n", A);
    printf("Bob sends to Alice (B)   : %lld\n", B);

    // Step 5: Compute shared secret keys
    keyA = power(B, a, p);
    keyB = power(A, b, p);

    printf("\n--- Computed Secret Keys ---\n");
    printf("Alice's Secret Key       : %lld\n", keyA);
    printf("Bob's Secret Key         : %lld\n", keyB);

    if (keyA == keyB) {
        printf("\nSuccess: Diffie-Hellman Key Exchange established successfully!\n");
    } else {
        printf("\nError: Keys do not match.\n");
    }

    return 0;
}


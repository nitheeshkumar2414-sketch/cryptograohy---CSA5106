// Function to encrypt plaintext using Rail Fence Cipher
void encryptRailFence(char *text, int rails) {
    int len = strlen(text);
    char rail[rails][len];
    
    // Initialize the rail matrix with '\n' to mark empty spaces
    for (int i = 0; i < rails; i++) {
        for (int j = 0; j < len; j++) {
            rail[i][j] = '\n';
        }
    }

    int row = 0, col = 0;
    int dir_down = 0; // Direction flag

    // Fill the rail matrix in a zig-zag pattern
    for (int i = 0; i < len; i++) {
        // Check directions of flow
        if (row == 0 || row == rails - 1) {
            dir_down = !dir_down;
        }

        rail[row][col++] = text[i];

        // Find the next row using direction flag
        if (dir_down) {
            row++;
        } else {
            row--;
        }
    }

    // Read the matrix row-wise to create the ciphertext
    printf("\nEncrypted Ciphertext: ");
    for (int i = 0; i < rails; i++) {
        for (int j = 0; j < len; j++) {
            if (rail[i][j] != '\n') {
                printf("%c", rail[i][j]);
            }
        }
    }
    printf("\n");
}

// Function to decrypt ciphertext using Rail Fence Cipher
void decryptRailFence(char *cipher, int rails) {
    int len = strlen(cipher);
    char rail[rails][len];

    // Initialize the rail matrix
    for (int i = 0; i < rails; i++) {
        for (int j = 0; j < len; j++) {
            rail[i][j] = '\n';
        }
    }

    int row = 0, col = 0;
    int dir_down;

    // Mark the places with '*' where characters will be placed
    for (int i = 0; i < len; i++) {
        if (row == 0) {
            dir_down = 1;
        }
        if (row == rails - 1) {
            dir_down = 0;
        }

        rail[row][col++] = '*';

        if (dir_down) {
            row++;
        } else {
            row--;
        }
    }

    // Fill the marked '*' positions with the ciphertext characters
    int index = 0;
    for (int i = 0; i < rails; i++) {
        for (int j = 0; j < len; j++) {
            if (rail[i][j] == '*' && index < len) {
                rail[i][j] = cipher[index++];
            }
        }
    }

    // Read the matrix in a zig-zag manner to reconstruct the plaintext
    printf("\nDecrypted Plaintext: ");
    row = 0;
    col = 0;
    for (int i = 0; i < len; i++) {
        if (row == 0) {
            dir_down = 1;
        }
        if (row == rails - 1) {
            dir_down = 0;
        }

        if (rail[row][col] != '\n') {
            printf("%c", rail[row][col++]);
        }

        if (dir_down) {
            row++;
        } else {
            row--;
        }
    }
    printf("\n");
}


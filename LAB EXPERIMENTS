#include <stdio.h>
#include <string.h>
#include <ctype.h>

#define SIZE 5

// Function to prepare the key matrix (5x5 grid)
void generateKeyMatrix(char key[], char matrix[SIZE][SIZE]) {
    int alphabetHash[26] = {0};
    int i, j, k = 0;

    // 'J' is usually combined with 'I' in Playfair
    alphabetHash['J' - 'A'] = 1; 

    // Fill matrix with key characters first
    for (i = 0; i < strlen(key); i++) {
        char ch = toupper(key[i]);
        if (ch == 'J') ch = 'I';

        if (ch >= 'A' && ch <= 'Z' && alphabetHash[ch - 'A'] == 0) {
            matrix[k / SIZE][k % SIZE] = ch;
            alphabetHash[ch - 'A'] = 1;
            k++;
        }
    }

    // Fill the rest of the matrix with remaining alphabet letters
    for (char ch = 'A'; ch <= 'Z'; ch++) {
        if (ch == 'J') continue; // Skip J

        if (alphabetHash[ch - 'A'] == 0) {
            matrix[k / SIZE][k % SIZE] = ch;
            alphabetHash[ch - 'A'] = 1;
            k++;
        }
    }
}

// Function to search for characters in the matrix and return their coordinates
void searchMatrix(char matrix[SIZE][SIZE], char ch1, char ch2, int *r1, int *c1, int *r2, int *c2) {
    if (ch1 == 'J') ch1 = 'I';
    if (ch2 == 'J') ch2 = 'I';

    for (int i = 0; i < SIZE; i++) {
        for (int j = 0; j < SIZE; j++) {
            if (matrix[i][j] == ch1) {
                *r1 = i;
                *c1 = j;
            } else if (matrix[i][j] == ch2) {
                *r2 = i;
                *c2 = j;
            }
        }
    }
}

// Function to format the plaintext (removes spaces, replaces J with I, handles pairs and padding)
int prepareText(char input[], char output[]) {
    int len = 0;
    for (int i = 0; input[i] != '\0'; i++) {
        if (isalpha(input[i])) {
            char ch = toupper(input[i]);
            if (ch == 'J') ch = 'I';
            output[len++] = ch;
        }
    }
    output[len] = '\0';

    // Insert 'X' between identical consecutive letters or pad single ending letter
    char processed[100];
    int pLen = 0;
    for (int i = 0; i < len; i++) {
        processed[pLen++] = output[i];
        if (i + 1 < len && output[i] == output[i + 1]) {
            processed[pLen++] = 'X'; // Padding character
        }
    }
    if (pLen % 2 != 0) {
        processed[pLen++] = 'X'; // Pad with X if length is odd
    }
    processed[pLen] = '\0';
    strcpy(output, processed);
    return pLen;
}

// Function to encrypt text using Playfair cipher rules
void encrypt(char matrix[SIZE][SIZE], char text[], int len) {
    for (int i = 0; i < len; i += 2) {
        int r1, c1, r2, c2;
        searchMatrix(matrix, text[i], text[i + 1], &r1, &c1, &r2, &c2);

        if (r1 == r2) { // Same row: shift columns right (wrap around)
            text[i] = matrix[r1][(c1 + 1) % SIZE];
            text[i + 1] = matrix[r2][(c2 + 1) % SIZE];
        } else if (c1 == c2) { // Same column: shift rows down (wrap around)
            text[i] = matrix[(r1 + 1) % SIZE][c1];
            text[i + 1] = matrix[(r2 + 1) % SIZE][c2];
        } else { // Rectangle: swap column coordinates
            text[i] = matrix[r1][c2];
            text[i + 1] = matrix[r2][c1];
        }
    }
}

int main() {
    char key[50], plaintext[100], cleanText[100];
    char matrix[SIZE][SIZE];

    printf("--- Playfair Cipher Program ---\n");
    
    printf("Enter the key: ");
    fgets(key, sizeof(key), stdin);
    key[strcspn(key, "\n")] = '\0';

    printf("Enter the plaintext: ");
    fgets(plaintext, sizeof(plaintext), stdin);
    plaintext[strcspn(plaintext, "\n")] = '\0';

    // Generate key matrix
    generateKeyMatrix(key, matrix);

    // Display 5x5 Key Matrix
    printf("\nGenerated 5x5 Key Matrix:\n");
    for (int i = 0; i < SIZE; i++) {
        for (int j = 0; j < SIZE; j++) {
            printf("%c ", matrix[i][j]);
        }
        printf("\n");
    }

    // Prepare and encrypt text
    int len = prepareText(plaintext, cleanText);
    printf("\nProcessed Plaintext (Padded): %s\n", cleanText);

    encrypt(matrix, cleanText, len);
    printf("Encrypted Ciphertext: %s\n", cleanText);

    return 0;
}


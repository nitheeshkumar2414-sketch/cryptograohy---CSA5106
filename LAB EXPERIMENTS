// Shift amounts for each round
const uint32_t s[64] = {
    7, 12, 17, 22,  7, 12, 17, 22,  7, 12, 17, 22,  7, 12, 17, 22,
    5,  9, 14, 20,  5,  9, 14, 20,  5,  9, 14, 20,  5,  9, 14, 20,
    4, 11, 16, 23,  4, 11, 16, 23,  4, 11, 16, 23,  4, 11, 16, 23,
    6, 10, 15, 21,  6, 10, 15, 21,  6, 10, 15, 21,  6, 10, 15, 21
};

void md5(uint8_t *initial_msg, size_t initial_len) {
    // Initialize MD buffer
    uint32_t h0 = 0x67452301;
    uint32_t h1 = 0xefcdab89;
    uint32_t h2 = 0x98badcfe;
    uint32_t h3 = 0x10325476;

    // Pre-processing: Padding
    size_t new_len = (((initial_len + 8) / 64) + 1) * 64;
    uint8_t *msg = (uint8_t *)calloc(new_len, 1);
    memcpy(msg, initial_msg, initial_len);
    msg[initial_len] = 0x80; // Append '1' bit (0x80 in byte)

    // Append original length in bits as 64-bit integer
    uint64_t bit_len = (uint64_t)initial_len * 8;
    memcpy(msg + new_len - 8, &bit_len, 8);

    // Process the message in 512-bit blocks (64 bytes)
    for (size_t offset = 0; offset < new_len; offset += 64) {
        uint32_t w[16];
        for (int i = 0; i < 16; i++) {
            w[i] = (uint32_t)msg[offset + i * 4] |
                   ((uint32_t)msg[offset + i * 4 + 1] << 8) |
                   ((uint32_t)msg[offset + i * 4 + 2] << 16) |
                   ((uint32_t)msg[offset + i * 4 + 3] << 24);
        }

        uint32_t a = h0;
        uint32_t b = h1;
        uint32_t c = h2;
        uint32_t d = h3;

        // Main Loop (64 operations across 4 rounds)
        for (int i = 0; i < 64; i++) {
            uint32_t f, g_idx;

            if (i < 16) {
                f = F(b, c, d);
                g_idx = i;
            } else if (i < 32) {
                f = G(b, c, d);
                g_idx = (5 * i + 1) % 16;
            } else if (i < 48) {
                f = H(b, c, d);
                g_idx = (3 * i + 5) % 16;
            } else {
                f = I(b, c, d);
                g_idx = (7 * i) % 16;
            }

            uint32_t temp = d;
            d = c;
            c = b;
            b = b + LEFTROTATE((a + f + k[i] + w[g_idx]), s[i]);
            a = temp;
        }

        h0 += a;
        h1 += b;
        h2 += c;
        h3 += d;
    }

    free(msg);

    // Print final 128-bit digest in Hex format

    printf("\nMD5 Hash Output: ");
    printf("%08x%08x%08x%08x\n", h0, h1, h2, h3);
}

int main() {

#define N 3

// Function to perform Matrix Multiplication modulo 26
void multiplyMatrix(int key[N][N], int messageVector[N][1], int cipherVector[N][1]) {
    for (int i = 0; i < N; i++) {
        cipherVector[i][0] = 0;
        for (int x = 0; x < N; x++) {
            cipherVector[i][0] += key[i][x] * messageVector[x][0];
        }
        cipherVector[i][0] = cipherVector[i][0] % 26;
    }
}

// Function to encrypt the plaintext using Hill Cipher
void hillCipherEncrypt(char message[], int key[N][N]) {
    int len = strlen(message);
    char cleanText[100];
    int cleanLen = 0;

    // Step 1: Clean input (keep letters only, convert to uppercase)
    for (int i = 0; i < len; i++) {
        if (isalpha(message[i])) {
            cleanText[cleanLen++] = toupper(message[i]);
        }
    }

    // Step 2: Pad text with 'X' if length is not a multiple of 3
    while (cleanLen % N != 0) {
        cleanText[cleanLen++] = 'X';
    }
    cleanText[cleanLen] = '\0';

    printf("\nProcessed Plaintext (Padded): %s\n", cleanText);

    char ciphertext[100] = "";
    int messageVector[N][1];
    int cipherVector[N][1];

    // Step 3: Process text in blocks of 3 letters
    for (int block = 0; block < cleanLen; block += N) {
        // Convert block letters into numerical column vector (A=0, B=1, ..., Z=25)
        for (int i = 0; i < N; i++) {
            messageVector[i][0] = cleanText[block + i] - 'A';
        }

        // Multiply key matrix by column vector
        multiplyMatrix(key, messageVector, cipherVector);

        // Convert resulting numbers back to letters
        for (int i = 0; i < N; i++) {
            int charIdx = strlen(ciphertext);
            ciphertext[charIdx] = cipherVector[i][0] + 'A';
            ciphertext[charIdx + 1] = '\0';
        }
    }

    printf("Encrypted Ciphertext: %s\n", ciphertext);
}

int main() {
    // Key string of length 9 for 3x3 matrix (e.g., "GYBNQKURP")
    char keyString[10];
    char message[100];
    int keyMatrix[N][N];

    printf("--- Hill Cipher Program (3x3 Matrix) ---\n");

    printf("Enter a 9-letter Keyword for 3x3 Matrix (e.g., GYBNQKURP): ");
    scanf("%9s", keyString);

    // Convert Keyword to 3x3 Key Matrix
    int k = 0;
    for (int i = 0; i < N; i++) {
        for (int j = 0; j < N; j++) {
            keyMatrix[i][j] = toupper(keyString[k++]) - 'A';
        }
    }

    // Display the Key Matrix
    printf("\nGenerated Key Matrix (3x3):\n");
    for (int i = 0; i < N; i++) {
        for (int j = 0; j < N; j++) {
            printf("%2d ", keyMatrix[i][j]);
        }
        printf("\n");
    }

    printf("\nEnter Plaintext: ");
    scanf("%s", message);

    hillCipherEncrypt(message, keyMatrix);

